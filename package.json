{
  "name": "mahin-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:workspace": "turbo run build",
    "lint:workspace": "turbo run lint",
    "typecheck:shared": "npm run typecheck --workspace=@mahin/marketplace-data",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.5.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.5.0",
    "vite": "^6.3.5",
    "@mahin/eslint-config": "*"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
